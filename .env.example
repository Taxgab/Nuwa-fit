# ---------------------------------------------------------------------------
# NUWA Fit — public configuration
#
# Copy this file to `.env` and fill in the values the gym has confirmed.
# Every variable is OPTIONAL: when empty, the site renders an explicit
# "pending" state instead of inventing data.
#
# `PUBLIC_` means the value is exposed to the browser. Never store secrets here.
# ---------------------------------------------------------------------------

# WhatsApp number in international format. Digits only when possible:
# 5491123456789 (country + area + number, no "+", spaces or dashes).
PUBLIC_WHATSAPP_NUMBER=

# Initial WhatsApp message, prefilled when someone taps a CTA.
# Leave empty to use the default message from src/data/site.ts.
PUBLIC_WHATSAPP_MESSAGE=

# Instagram profile URL (e.g. https://instagram.com/nuwa.fit).
PUBLIC_INSTAGRAM_URL=

# Handle shown in the UI. Inferred from PUBLIC_INSTAGRAM_URL when empty.
PUBLIC_INSTAGRAM_HANDLE=

# Street address shown in the contact and footer sections.
PUBLIC_GYM_ADDRESS=

# Google Maps link to the exact location.
PUBLIC_MAPS_URL=

# Production URL, used for canonical and Open Graph absolute URLs.
# Example: https://nuwafit.com.ar
PUBLIC_SITE_URL=
