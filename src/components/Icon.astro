---
import type { IconName } from "../data/site";

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
  /** Any extra attribute is forwarded to the root `<svg>` (e.g. data-*). */
  [key: string]: unknown;
}

const { name, class: className = "h-5 w-5", strokeWidth = 1.8, ...rest } = Astro.props;

/** Brand glyphs are filled; the rest are line icons on the same 24px grid. */
const filled: readonly IconName[] = ["whatsapp"];
const isFilled = filled.includes(name);
---

<svg
  {...rest}
  class={className}
  viewBox="0 0 24 24"
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow" && <path d="M7 17 17 7M7.5 7H17v9.5" />}
  {name === "menu" && <path d="M3.5 7h17M3.5 12h17M3.5 17h17" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "check" && <path d="m4.5 12.5 5 5L19.5 6.5" />}
  {
    name === "pin" && (
      <>
        <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
        <circle cx="12" cy="10" r="2.6" />
      </>
    )
  }
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="8.8" />
        <path d="M12 7.4V12l3.2 1.9" />
      </>
    )
  }
  {
    name === "instagram" && (
      <>
        <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.1" cy="6.9" r="1.05" fill="currentColor" stroke="none" />
      </>
    )
  }
  {name === "spark" && <path d="M12 3v18M3 12h18M6.2 6.2l11.6 11.6M17.8 6.2 6.2 17.8" />}
  {
    name === "target" && (
      <>
        <circle cx="12" cy="12" r="8.6" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "users" && (
      <>
        <circle cx="9" cy="8.6" r="3.5" />
        <path d="M2.9 19.8a6.2 6.2 0 0 1 12.2 0" />
        <path d="M16.1 5.3a3.5 3.5 0 0 1 0 6.7M17.7 14.3a6.2 6.2 0 0 1 3.4 5.5" />
      </>
    )
  }
  {
    name === "repeat" && (
      <>
        <path d="M4 9.2V7.6A3.6 3.6 0 0 1 7.6 4H18" />
        <path d="m15.2 1.7 3 2.4-3 2.4" />
        <path d="M20 14.8v1.6a3.6 3.6 0 0 1-3.6 3.6H6" />
        <path d="m8.8 22.3-3-2.4 3-2.4" />
      </>
    )
  }
  {
    name === "whatsapp" && (
      <>
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.45.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z" />
        <path d="M20.52 3.45A11.87 11.87 0 0 0 12.05 0C5.46 0 .1 5.33.1 11.89c0 2.1.55 4.14 1.6 5.95L0 24l6.34-1.65a11.9 11.9 0 0 0 5.71 1.45h.01c6.58 0 11.94-5.34 11.95-11.9 0-3.17-1.24-6.16-3.49-8.41ZM12.05 22.3h-.01c-1.79 0-3.55-.48-5.08-1.39l-.36-.22-3.77.99 1.01-3.66-.24-.38a9.85 9.85 0 0 1-1.51-5.26c0-5.45 4.46-9.88 9.94-9.88 2.65 0 5.14 1.03 7.02 2.91a9.82 9.82 0 0 1 2.9 6.99c0 5.45-4.46 9.89-9.91 9.89Z" />
      </>
    )
  }
</svg>
