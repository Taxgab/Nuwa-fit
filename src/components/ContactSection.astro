---
import ChannelCard from "./ChannelCard.astro";
import Icon from "./Icon.astro";
import { contact, whatsappLink } from "../data/site";

const whatsappHref = whatsappLink();
const whatsappValue = contact.hasWhatsApp ? `+${contact.whatsappNumber}` : "Número pendiente de confirmación";
const instagramValue = contact.hasInstagram ? contact.instagramHandle : "Perfil pendiente de confirmación";
const addressValue = contact.hasAddress ? contact.address : "Dirección pendiente de confirmación";

const hasPendingContact = !contact.hasWhatsApp || !contact.hasInstagram || !contact.hasAddress || !contact.hasMaps;
---

<section id="contacto" class="border-t border-line py-20 md:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow">Contacto</p>
      <h2 class="display mt-4 text-[clamp(2.3rem,5.6vw,4rem)]">
        Hablemos de<br />
        <span class="text-brand-tint">tu próximo paso.</span>
      </h2>

      <p class="mt-6 max-w-md text-sm leading-7 text-muted">
        Escribinos para consultar clases, horarios y cómo sumarte. La conversación empieza por WhatsApp o Instagram.
      </p>

      {
        hasPendingContact && (
          <p class="mt-6 flex max-w-md items-start gap-2.5 rounded-xl border border-dashed border-line p-4 text-xs leading-6 text-faint">
            <Icon name="clock" class="mt-0.5 h-3.5 w-3.5 shrink-0" />
            <span>
              Algunos datos de contacto todavía no están confirmados por el gimnasio. Se muestran como pendientes para
              no publicar información incorrecta.
            </span>
          </p>
        )
      }
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <ChannelCard
        icon="whatsapp"
        label="WhatsApp"
        value={whatsappValue}
        href={whatsappHref}
        pending={!contact.hasWhatsApp}
      />

      <ChannelCard
        icon="instagram"
        label="Instagram"
        value={instagramValue}
        href={contact.hasInstagram ? contact.instagramUrl : null}
        pending={!contact.hasInstagram}
      />

      <ChannelCard
        icon="pin"
        label="Ubicación"
        value={addressValue}
        href={contact.hasMaps ? contact.mapsUrl : null}
        pending={!contact.hasAddress}
      />

      {
        contact.hasHours ? (
          <div class="card flex flex-col justify-between gap-6 p-5">
            <span class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-raised text-brand-tint">
              <Icon name="clock" class="h-4 w-4" />
            </span>
            <div>
              <p class="text-[0.6rem] font-bold tracking-[0.18em] text-faint uppercase">Horarios</p>
              <ul class="mt-1.5 space-y-1 text-sm leading-6 text-ink">
                {contact.hours.map((slot) => (
                  <li>
                    <span class="text-muted">{slot.days}:</span> {slot.time}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <div class="card flex flex-col justify-between gap-6 border-dashed p-5">
            <span class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-raised text-brand-tint">
              <Icon name="clock" class="h-4 w-4" />
            </span>
            <div>
              <p class="text-[0.6rem] font-bold tracking-[0.18em] text-faint uppercase">Horarios</p>
              <p class="mt-1.5 text-sm leading-6 text-muted">
                Se publican cuando el gimnasio los confirme. Mientras tanto, consultalos por mensaje.
              </p>
            </div>
          </div>
        )
      }

      {
        contact.hasMaps ? (
          <a
            class="card group relative flex min-h-[168px] items-end overflow-hidden p-5 transition hover:border-brand-tint/40 sm:col-span-2"
            href={contact.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="grid-backdrop absolute inset-0 opacity-40" aria-hidden="true" />
            <span class="absolute top-5 right-5 grid h-9 w-9 place-items-center rounded-lg border border-line bg-carbon/80 text-brand-tint">
              <Icon name="pin" class="h-4 w-4" />
            </span>
            <span class="relative">
              <span class="text-[0.6rem] font-bold tracking-[0.18em] text-faint uppercase">Cómo llegar</span>
              <span class="mt-1.5 block text-sm font-semibold text-ink">Abrir la ubicación en Google Maps</span>
            </span>
          </a>
        ) : (
          <div class="card relative flex min-h-[168px] items-end overflow-hidden border-dashed p-5 sm:col-span-2">
            <span class="grid-backdrop absolute inset-0 opacity-30" aria-hidden="true" />
            <span class="absolute top-5 right-5 text-[0.55rem] font-semibold tracking-[0.16em] text-faint uppercase">
              A confirmar
            </span>
            <div class="relative">
              <p class="text-[0.6rem] font-bold tracking-[0.18em] text-faint uppercase">Cómo llegar</p>
              <p class="mt-1.5 text-sm leading-6 text-muted">
                Falta cargar la dirección y el enlace de Google Maps del gimnasio.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
